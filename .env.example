# BritBrokers configuration.
# Copy to "britbrokers.env" in the folder ABOVE the web root (recommended),
# or set BRITBROKERS_ENV_FILE to its path, or set these as real environment variables.
# Never commit the real file.

# Database
DB_HOST="localhost"
DB_NAME="britbrok_main"
DB_USER="britbrok_dbu"
DB_PASSWORD="change-me"

# Admin login. Generate the hash with:  php bin/hash-password.php
ADMIN_USER="britbrokers"
ADMIN_PASSWORD_HASH=""

# Public URL of the site, no trailing slash
SITE_URL="https://www.britbrokers.com/live"

# Email
# Address the site sends from (must be a mailbox on your domain, or mail gets marked as spam)
MAIL_FROM="contact@britbrokers.com"
MAIL_FROM_NAME="British Brokers"
# Where contact-form messages go
CONTACT_TO="info@britbrokers.com"
# Optional SMTP. Leave MAIL_SMTP_HOST empty to use PHP mail()
MAIL_SMTP_HOST=""
MAIL_SMTP_PORT="587"
MAIL_SMTP_USER=""
MAIL_SMTP_PASSWORD=""
# tls, ssl or none
MAIL_SMTP_SECURE="tls"

# openexchangerates.org API key (used by bin/update-exchange-rates.php)
OPENEXCHANGERATES_APP_ID=""

# Blog (WordPress) tables used for "Latest News" on the home page
WP_TABLE_PREFIX="bbb_"
WP_UPLOADS_URL="https://britbrokers.com/blog/wp-content/uploads"
