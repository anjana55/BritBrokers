# Uploaded files are images only: never run them as scripts.
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<IfModule mod_php.c>
	php_flag engine off
</IfModule>
<IfModule mod_php7.c>
	php_flag engine off
</IfModule>
<IfModule mod_php8.c>
	php_flag engine off
</IfModule>

# Only serve image files from here
<FilesMatch "\.(?i:jpe?g|png|gif|webp)$">
	Require all granted
</FilesMatch>
<FilesMatch "^(?!.*\.(?i:jpe?g|png|gif|webp)$).*$">
	Require all denied
</FilesMatch>
